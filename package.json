{
  "name": "riley-task-app",
  "version": "1.0.27",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "test:api": "node --test server/app.test.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.mjs migrate",
    "db:import": "node --env-file-if-exists=.env scripts/database.mjs import",
    "db:export": "node --env-file-if-exists=.env.migration.local scripts/export-supabase.mjs"
  },
  "dependencies": {
    "connect-pg-simple": "10.0.0",
    "date-fns": "^2.30.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "lucide-react": "^0.562.0",
    "pg": "8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "26.6.5",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "concurrently": "10.0.6",
    "jsdom": "^23.0.1",
    "supertest": "7.3.1",
    "typescript": "^5.3.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
